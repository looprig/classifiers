{
  "type": "object",
  "description": "The structured command-safety review verdict for exactly one prepared tool call.",
  "properties": {
    "version": {
      "type": "string",
      "description": "The literal wire version string command_safety_output.v1."
    },
    "basis": {
      "type": "object",
      "description": "The review basis, echoed back exactly as supplied in the input.",
      "properties": {
        "gate_id": { "type": "string" },
        "tool_execution_id": { "type": "string" },
        "subject_digest": { "type": "string" },
        "context_revision": { "type": "string" },
        "gate_policy_revision": { "type": "string" },
        "classifier_revision": { "type": "string" },
        "security_ceiling": { "type": "string" }
      },
      "required": [
        "gate_id",
        "tool_execution_id",
        "subject_digest",
        "context_revision",
        "gate_policy_revision",
        "classifier_revision",
        "security_ceiling"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "string",
      "description": "The intrinsic hazard of the action, independent of authorization.",
      "enum": ["low", "medium", "high", "critical"]
    },
    "authorization": {
      "type": "string",
      "description": "The strength of evidence the current user asked for or approved this exact action.",
      "enum": ["unknown", "low", "medium", "high"]
    },
    "categories": {
      "type": "array",
      "description": "Every applicable closed risk category. May be empty.",
      "items": {
        "type": "string",
        "enum": [
          "data_exfiltration",
          "credential_access",
          "credential_probing",
          "destructive_local",
          "destructive_shared",
          "persistent_security_weakening",
          "production_mutation",
          "protected_source_control",
          "untrusted_code_execution",
          "mutable_network",
          "prompt_injection",
          "authorization_conflict",
          "target_ambiguity",
          "insufficient_evidence"
        ]
      }
    },
    "recommendation": {
      "type": "string",
      "description": "allow makes this one action eligible for a local one-shot decision; needs_human defers to the human gate.",
      "enum": ["allow", "needs_human"]
    },
    "rationale": {
      "type": "string",
      "description": "One concise rationale. Never a reasoning trace or chain of thought."
    }
  },
  "required": [
    "version",
    "basis",
    "risk",
    "authorization",
    "categories",
    "recommendation",
    "rationale"
  ],
  "additionalProperties": false
}
